# Server only. Copy to .env and fill locally. Never put keys in VITE_* variables.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# RunningHub Enterprise-Shared API key, required by their Model API.
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.ai
# 1-4 in-flight video tasks; defaults to 2.
RUNNINGHUB_CONCURRENCY=4
# Optional public HTTPS portrait. If omitted, production uploads public/avatar-reference.png.
AVATAR_IMAGE_URL=
# Confidence thresholds are initial settings, not measured accuracy guarantees.
ROUTING_MIN_CONFIDENCE=0.65
ROUTING_MIN_PROBABILITY=0.55
PORT=4173
